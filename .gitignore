# The generator's own scratch files: it writes probe scripts beside itself and
# removes them, but an interrupted run can leave one behind.
tools/_peer-resolver.mjs
tools/_host-probe.mjs
tools/_compat-probe.mjs
tools/_*-probe.mjs

