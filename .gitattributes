# The generated JavaScript must survive a clone byte for byte: `verify.py`
# compares the inlined solver against `solver.js` textually, and a rebuild is
# expected to reproduce the committed files exactly.
#
# Everything is stored and checked out with LF, on every platform. The generator
# writes LF (`newline="\n"` in `build_palettes.py`), so a checkout that produced
# CRLF would make a rebuild look like a full-file rewrite.
* text=auto eol=lf

# Artwork is binary and must never be line-ending converted.
*.png binary
*.jpg binary
*.jpeg binary
